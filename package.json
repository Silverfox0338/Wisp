{
  "name": "@silverfox0338/wisp",
  "version": "0.0.9",
  "description": "A scripting language and CLI for Discord bots",
  "license": "GPL-3.0-only",
  "author": "Silverfox0338",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Silverfox0338/Wisp.git"
  },
  "homepage": "https://github.com/Silverfox0338/Wisp#readme",
  "bugs": "https://github.com/Silverfox0338/Wisp/issues",
  "type": "module",
  "files": [
    "dist/cli",
    "dist/compiler",
    "dist/discord",
    "dist/project",
    "dist/runtime",
    "dist/storage",
    "dist/diagnostics.js",
    "dist/version.js",
    "src",
    "prepare-package.mjs",
    "tsconfig.json",
    "eslint.config.js",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "wisp": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "node prepare-package.mjs",
    "prepublishOnly": "npm run lint && npm test",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src"
  },
  "engines": {
    "node": ">=24.17.0"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "redis": "^6.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "^8.23.1",
    "eslint": "10.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
