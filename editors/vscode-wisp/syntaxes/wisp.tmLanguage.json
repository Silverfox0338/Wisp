{
  "name": "Wisp",
  "scopeName": "source.wisp",
  "patterns": [
    {"include": "#markdownBlock"},
    {"include": "#comments"},
    {"include": "#strings"},
    {"include": "#declarations"},
    {"include": "#metadata"},
    {"include": "#keywords"},
    {"include": "#constants"},
    {"include": "#namespaces"},
    {"include": "#builtins"},
    {"include": "#numbers"},
    {"include": "#operators"}
  ],
  "repository": {
    "markdownBlock": {"patterns": [{"name": "string.unquoted.block.wisp", "begin": "^(\\s*)markdown:\\s*$", "end": "^(?!\\1    |\\s*$)", "patterns": [{"include": "#interpolation"}]}]},
    "comments": {"patterns": [{"name": "comment.line.number-sign.wisp", "match": "#.*$"}]},
    "strings": {"patterns": [
      {"name": "string.quoted.double.wisp", "begin": "\"", "end": "(?<!\\\\)\"", "patterns": [{"include": "#escapes"}, {"include": "#interpolation"}]},
      {"name": "string.quoted.single.wisp", "begin": "'", "end": "(?<!\\\\)'", "patterns": [{"include": "#escapes"}, {"include": "#interpolation"}]}
    ]},
    "escapes": {"patterns": [{"name": "constant.character.escape.wisp", "match": "\\\\(?:[\\\\\"'nrt]|.)"}]},
    "interpolation": {"patterns": [{"name": "meta.interpolation.wisp", "begin": "\\{", "beginCaptures": {"0": {"name": "punctuation.definition.interpolation.begin.wisp"}}, "end": "\\}", "endCaptures": {"0": {"name": "punctuation.definition.interpolation.end.wisp"}}, "patterns": [{"include": "#namespaces"}, {"include": "#builtins"}, {"include": "#constants"}, {"include": "#numbers"}, {"include": "#operators"}]}]},
    "declarations": {"patterns": [
      {"match": "\\b(user|message)(\\s+)(command)(\\s+)(\\\"[^\\\"]+\\\")", "captures": {"1": {"name": "keyword.declaration.command.wisp"}, "3": {"name": "keyword.declaration.command.wisp"}, "5": {"name": "entity.name.function.command.wisp"}}},
      {"match": "\\b(subcommand|group)(\\s+)(\\\"[^\\\"]+\\\"|[A-Za-z_][A-Za-z_0-9-]*)", "captures": {"1": {"name": "keyword.declaration.command.wisp"}, "3": {"name": "entity.name.function.command.wisp"}}},
      {"match": "\\b(command)(\\s+)(\\\"[^\\\"]+\\\")", "captures": {"1": {"name": "keyword.declaration.command.wisp"}, "3": {"name": "entity.name.function.command.wisp"}}},
      {"match": "\\b(event|on)(\\s+)(ready|member_join|member_leave|message_create|message_update|message_delete|gateway)\\b", "captures": {"1": {"name": "keyword.declaration.event.wisp"}, "3": {"name": "entity.name.function.event.wisp"}}},
      {"match": "\\b(function)(\\s+)([A-Za-z_][A-Za-z_0-9]*)", "captures": {"1": {"name": "keyword.declaration.function.wisp"}, "3": {"name": "entity.name.function.wisp"}}}
    ]},
    "metadata": {"patterns": [{"match": "\\b(type)(\\s*:\\s*)(string|integer|number|boolean|user|role|channel)\\b", "captures": {"1": {"name": "entity.name.tag.metadata.wisp"}, "3": {"name": "support.type.option.wisp"}}}, {"name": "entity.name.tag.metadata.wisp", "match": "\\b(?:description|permission|default_member_permissions|timeout|defer|type|required|choices|min|max|title|color|fields|thumbnail|image|footer|timestamp|ephemeral|components|content|accent|markdown|text|v1|v2)\\b(?=\\s*:)"}, {"name": "entity.name.tag.metadata.wisp", "match": "\\bdescription\\b(?=\\s*(?:\\\"|'))"}]},
    "keywords": {"patterns": [{"name": "keyword.control.wisp", "match": "\\b(?:event|on|let|global|return|try|catch|raise|if|elif|else|for|in|while|and|or|not|execute|option|subcommand|group|suggest|cooldown|per|with|reply|embed|v1|v2|container|section|separator|row|import|as|export|every|after|seconds|show|button|select|user_select|role_select|channel_select|modal|choice|input)\\b"}]},
    "constants": {"patterns": [{"name": "constant.language.wisp", "match": "\\b(?:true|false|null)\\b"}]},
    "namespaces": {"patterns": [{"name": "support.class.discord.wisp", "match": "\\b(?:interaction|options|guild|user|storage|time|math|json|log|event|scheduler)\\b(?=\\.)"}]},
    "builtins": {"patterns": [{"name": "support.function.builtin.wisp", "match": "\\b(?:len|range|joinRank|firstMembers|lastMembers|joinPage|members|member|followUp|defer|get|set|delete|has|increment|sharedGet|sharedSet|sharedIncrement|now|iso|parse|format|add|diff|relative|discord|duration|abs|floor|ceil|round|min|max|randomInt|randomChoice|clamp|keys|values|entries|append|remove|pop|insert|index|slice|sort|reverse|map|filter|find|contains|join|split|trim|upper|lower|replace|starts_with|ends_with|substring|pad_start|pad_end|regex_match|regex_replace|stringify|info|warn|error|debug|cancel)\\b(?=\\s*\\()"}]},
    "numbers": {"patterns": [{"name": "constant.numeric.wisp", "match": "\\b\\d+(?:\\.\\d+)?\\b"}]},
    "operators": {"patterns": [{"name": "keyword.operator.wisp", "match": "==|!=|<=|>=|\\?\\?|[+*/=<>&-]"}, {"name": "punctuation.separator.wisp", "match": "[.,:]"}]}
  }
}
