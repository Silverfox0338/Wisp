{
  "Command":{"prefix":"command","body":["command \"${1:name}\":","    description \"${2:Description}\"","    execute:","        reply \"${3:Hello!}\""],"description":"Slash command"},
  "Option":{"prefix":"option","body":["option ${1:name}:","    type: ${2:user}","    description: \"${3:Option description}\"","    required: false"],"description":"Slash command option"},
  "Event":{"prefix":"on","body":["on ${1:member_join}:","    ${2:log.info(\"Event received\")}"],"description":"Event handler"},
  "Button":{"prefix":"button","body":["button \"${1:confirm}\":","    label: \"${2:Confirm}\"","    style: \"${3:success}\"","    owner: \"user\""],"description":"Interactive button"},
  "String select":{"prefix":"select","body":["select \"${1:choice}\":","    placeholder: \"${2:Choose}\"","    choice \"${3:value}\":","        label: \"${4:Label}\""],"description":"String select menu"},
  "Modal":{"prefix":"show modal","body":["show modal \"${1:feedback}\":","    title: \"${2:Feedback}\"","    input \"${3:message}\":","        label: \"${4:Message}\"","        style: \"paragraph\""],"description":"Modal dialog"},
  "Import":{"prefix":"import","body":["import \"${1:utils/formatting.wisp}\""],"description":"Local Wisp module"},
  "Schedule":{"prefix":"every","body":["every \"${1:heartbeat}\" ${2:60} seconds:","    ${3:log.info(\"Running\")}"],"description":"Recurring task"},
  "Try catch":{"prefix":"try","body":["try:","    ${1:raise \"Something went wrong\"}","catch ${2:error}:","    log.warn(${2:error}.message)"],"description":"Handle a Wisp error"},
  "Function with default":{"prefix":"function","body":["function ${1:name}(${2:value}, ${3:fallback} = ${4:null}):","    return ${2:value} ?? ${3:fallback}"],"description":"Function with an optional parameter"},
  "Range loop":{"prefix":"forrange","body":["for ${1:index} in range(${2:0}, ${3:10}):","    ${4:log.info(${1:index})}"],"description":"Loop over a bounded integer range"},
  "Map entries":{"prefix":"forentries","body":["for ${1:entry} in ${2:items}:","    log.info(\"{${1:entry}.key}: {${1:entry}.value}\")"],"description":"Loop over map entries"},
  "JSON parse":{"prefix":"jsonparse","body":["let ${1:data} = json.parse(${2:text})"],"description":"Parse JSON text"}
}
